---
title: Ephemera
layout: base.njk
hideSidebar: true
description: "Exhibition announcements, catalogues, reviews, installation photographs and studio ephemera documenting Robert Egert's career from 1984 to present."
---

<div class="press-columns">
{%- for item in ephemera %}

  <div class="press-entry">
    <div class="press-entry-header">
      <span class="press-entry-type">{{ item.type }}</span>
      {%- if item.externalLink %}
      <h2 class="press-entry-title"><a href="{{ item.externalLink }}">{{ item.title | safe }}</a></h2>
      {%- else %}
      <h2 class="press-entry-title">{{ item.title | safe }}</h2>
      {%- endif %}
      {%- if item.date %}
      <span class="press-entry-date">{{ item.date }}</span>
      {%- endif %}
    </div>
    {%- if item.images.length > 0 %}
    <a href="{{ item.images[0] }}" class="glightbox" data-gallery="{{ item.gallery }}" data-description="{{ item.description | safe }}">
      <img src="{{ item.images[0] }}" alt="{{ item.alt }}" loading="lazy">
    </a>
    {%- for image in item.images %}
      {%- if loop.index0 > 0 %}
    <a href="{{ image }}" class="glightbox" data-gallery="{{ item.gallery }}" data-description="{{ item.description | safe }}"></a>
      {%- endif %}
    {%- endfor %}
    {%- endif %}
    {%- for paragraph in item.text %}
    <p class="press-entry-text">{{ paragraph | safe }}</p>
    {%- endfor %}
    {%- if item.download %}
    <a class="press-download" href="{{ item.download }}" target="_blank">Download PDF</a>
    {%- endif %}
    {%- if item.externalLink %}
    <a class="press-download" href="{{ item.externalLink }}">Read Full Essay</a>
    {%- endif %}
  </div>
{%- endfor %}

</div>
