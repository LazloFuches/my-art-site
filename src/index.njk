---
title: Projects
layout: base.njk
pageType: homepage
hideSidebar: true
---

{%- for project in projects %}
  {%- if project.featured %}
<section class="hero">
  <div class="hero-image">
    <a href="/projects/{{ project.slug }}/">
      {% image project.thumbnail, project.title, "detail" %}
    </a>
  </div>
  <div class="hero-right">
    <h1 class="hero-artist">Robert Egert</h1>
    <div class="hero-bio">
      <p>Born in Brooklyn in 1958, he has worked as a painter for four decades, moving between figuration, abstraction, and abstract narrative. He emerged in the early 1980s in New York with solo exhibitions at White Columns and Civilian Warfare, and was included in group exhibitions at Holly Solomon Gallery. His work is held in private and institutional collections in the US and Europe. He has written on art for publications that include Flash Art International and Hyperallergic.</p>
    </div>
    <div class="hero-caption">
      <span class="hero-caption-title">{{ project.title }}</span>
      <span class="hero-caption-details">{{ project.year }}, {{ project.count }} works</span>
    </div>
    <a href="/projects/{{ project.slug }}/" class="hero-link">View Recent Work</a>
  </div>
</section>
  {%- endif %}
{%- endfor %}

<section class="archive-section">
  <span class="archive-label">Archive</span>
  <div class="press-columns">
    {%- for project in projects %}
      {%- if not project.featured and project.thumbnail %}
    <div class="press-entry project-entry">
      <a href="/projects/{{ project.slug }}/">
        {% image project.thumbnail, project.title, "thumbnail" %}
      </a>
      <div class="project-entry-meta">
        <a href="/projects/{{ project.slug }}/" class="project-entry-title">{{ project.title }}</a>
        <span class="project-entry-details">{{ project.count }} works, {{ project.year }}</span>
      </div>
    </div>
      {%- endif %}
    {%- endfor %}
  </div>
</section>
