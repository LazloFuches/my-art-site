---
pagination:
  data: collections.currentWorkArtworks
  size: 1
  alias: artwork
permalink: "/current-work/{{ artwork.slug }}/"
layout: base.njk
pageType: current-work-detail
hideSidebar: true
eleventyComputed:
  title: "{{ artwork.title }} — Robert Egert"
  description: "{{ artwork.title }}, {{ artwork.medium }}, {{ artwork.dimensions }}, {{ artwork.date }}. Painting by Robert Egert."
  ogImage: "{{ artwork.src }}"
---

<article class="cw-detail">
  <nav class="cw-detail__breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <span class="cw-detail__sep">/</span>
    <a href="/current-work/">Current Work</a> <span class="cw-detail__sep">/</span>
    <span>{{ artwork.title }}</span>
  </nav>

  <div class="cw-detail__gallery">
    <figure class="cw-detail__figure">
      {% image artwork.src, artwork.title + ", " + artwork.medium + ", " + artwork.dimensions + ", " + artwork.date, "detail", "cw-detail__img", true %}
    </figure>
  </div>

  <div class="cw-detail__content">
    <div class="cw-detail__info">
      <h1 class="cw-detail__title">{{ artwork.title }}</h1>
      <dl class="cw-detail__specs">
        <dt class="cw-detail__label">Medium</dt>
        <dd class="cw-detail__value">{{ artwork.medium }}</dd>
        <dt class="cw-detail__label">Dimensions</dt>
        <dd class="cw-detail__value">{{ artwork.dimensions }}</dd>
        <dt class="cw-detail__label">Date</dt>
        <dd class="cw-detail__value">{{ artwork.date }}</dd>
        {%- if artwork.collection %}
        <dt class="cw-detail__label">Collection</dt>
        <dd class="cw-detail__value">{{ artwork.collection }}</dd>
        {%- endif %}
      </dl>
      {%- if not artwork.collection %}
      <button class="cw-inquire-btn" onclick="openInquiry()">Inquire About This Work</button>
      {%- endif %}
    </div>

    <nav class="cw-detail__nav" aria-label="Artwork navigation">
      {%- if artwork.index > 0 %}
      <a href="/current-work/{{ collections.currentWorkArtworks[artwork.index - 1].slug }}/" class="cw-detail__nav-link cw-detail__prev">&larr; Previous</a>
      {%- else %}
      <span class="cw-detail__nav-link"></span>
      {%- endif %}
      <span class="cw-detail__counter">{{ artwork.index + 1 }} / {{ artwork.total }}</span>
      {%- if artwork.index < artwork.total - 1 %}
      <a href="/current-work/{{ collections.currentWorkArtworks[artwork.index + 1].slug }}/" class="cw-detail__nav-link cw-detail__next">Next &rarr;</a>
      {%- else %}
      <span class="cw-detail__nav-link"></span>
      {%- endif %}
    </nav>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VisualArtwork",
    "name": "{{ artwork.title }}",
    "creator": {
      "@type": "Person",
      "name": "Robert Egert",
      "url": "https://robertegert.com"
    },
    "dateCreated": "{{ artwork.date }}",
    "artMedium": "{{ artwork.medium }}",
    "artform": "Painting",
    "width": {
      "@type": "Distance",
      "name": "{{ artwork.dimensions }}"
    },
    "image": "https://robertegert.com{{ artwork.src }}",
    "url": "https://robertegert.com/current-work/{{ artwork.slug }}/",
    "isPartOf": {
      "@type": "Collection",
      "name": "{{ artwork.projectTitle }}",
      "url": "https://robertegert.com/current-work/"
    }{% if not artwork.collection %},
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "USD",
      "price": "0",
      "description": "Available for inquiry"
    }{% endif %}
  }
  </script>
</article>

{%- if not artwork.collection %}
{% include "inquiry-modal.njk" %}
{%- endif %}
