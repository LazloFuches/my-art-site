---
layout: base.njk
---

<div class="breadcrumb">
  <a href="/">Projects</a> <span class="breadcrumb-sep">/</span> <span>{{ title }}</span>
</div>
<div class="project-header">
  <h1 class="project-title-large">{{ title }}</h1>
  <span class="project-year-large">{{ year }}</span>
</div>
{% if summary %}<p class="page-summary">{{ summary }}</p>{% endif %}
<div class="press-columns">
  {%- for image in images %}
  <div class="press-entry">
    <a href="/projects/{{ page.fileSlug }}/{{ loop.index }}/">
      {% image image.src, image.title + ", " + image.medium + ", " + image.dimensions + ", " + image.date, "grid" %}
    </a>
    <figcaption>
      <a href="/projects/{{ page.fileSlug }}/{{ loop.index }}/" class="caption-title">{{ image.title }}</a>
      <span class="caption-details">{{ image.medium }}, {{ image.dimensions }}, {{ image.date }}</span>
      {%- if image.collection %}
      <span class="caption-collection">{{ image.collection }}</span>
      {%- endif %}
    </figcaption>
  </div>
  {%- endfor %}
</div>

<div class="other-projects">
  <span class="other-projects-label">Other Projects</span>
  <nav class="other-projects-list">
    {%- for project in projects %}
      {%- if project.slug != page.fileSlug %}
    <a href="/projects/{{ project.slug }}/">{{ project.title }}</a>
      {%- endif %}
    {%- endfor %}
  </nav>
</div>
